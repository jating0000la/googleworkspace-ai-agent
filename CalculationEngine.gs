/*************************************************************************************
 * UNIVERSAL DYNAMIC CALCULATION ENGINE — Google Apps Script (V8 runtime)
 *
 * A generic, sheet-agnostic calculation & aggregation engine. It is driven entirely
 * by structured JSON requests (typically generated by an LLM) and returns
 * structured JSON results (typically consumed by an LLM to write a human-readable
 * report). No sheet name, column name, or business domain is hard-coded anywhere
 * in this file — everything is resolved dynamically at request time.
 *
 * PUBLIC API (call these from your own code / from a doGet or doPost handler):
 *
 *   calculate(request)              -> run one calculation, or a multi-calculation
 *                                       batch, or a COMPARE request
 *   validateRequest(request)        -> { valid: boolean, errors: string[] }
 *   getSheetSchema(sheetName)       -> headers + inferred types + row count
 *   getAvailableColumns(sheetName)  -> list of header names
 *   getSupportedOperations()        -> list of operation names + short docs
 *
 * ARCHITECTURE (each is a plain object "module" — GAS files share one global
 * scope, so namespacing this way keeps things organized without needing a
 * module system):
 *
 *   DataParser        - safe type parsing (numbers, dates, booleans)
 *   DateEngine        - relative date-range resolution (THIS_MONTH, LAST_7_DAYS, ...)
 *   SchemaEngine       - sheet access, bulk reads, header/column resolution, caching
 *   FilterEngine       - the dynamic filter/condition engine (AND/OR, nested groups)
 *   FormulaEngine      - a safe expression evaluator (NO eval()) for FORMULA ops
 *   AggregationEngine  - the OPERATIONS registry (SUM, AVERAGE, GROUP_BY, TOP_N, ...)
 *   ValidationEngine   - request validation
 *   ResultFormatter    - consistent success/error JSON shaping
 *   CalculationEngine  - orchestrates all of the above for calculate()
 *
 * See the bottom of this file for example requests and runnable test functions
 * (test_setupSampleData, runAllEngineTests, ...).
 *************************************************************************************/

// ============================================================================
// 0. GLOBAL CONFIG & ERROR CODES
// ============================================================================

const ENGINE_CONFIG = {
  DEFAULT_HEADER_ROW: 1,
  SCHEMA_CACHE_SECONDS: 300,      // how long inferred header/type info is cached
  SCHEMA_SAMPLE_ROWS: 100,        // rows sampled to infer a column's data type
  MAX_ROWS_HARD_LIMIT: 200000,    // safety ceiling so a runaway request can't hang
  MAX_WARNINGS_PER_ISSUE: 5,      // avoid flooding the response with repeat warnings
  DEFAULT_CURRENCY: 'INR',
  DEFAULT_WEEK_START: 1           // 0 = Sunday, 1 = Monday
};

const ERROR_CODES = {
  SHEET_NOT_FOUND: 'SHEET_NOT_FOUND',
  COLUMN_NOT_FOUND: 'COLUMN_NOT_FOUND',
  AMBIGUOUS_COLUMN: 'AMBIGUOUS_COLUMN',
  INVALID_OPERATION: 'INVALID_OPERATION',
  INVALID_OPERATOR: 'INVALID_OPERATOR',
  INVALID_DATE: 'INVALID_DATE',
  INVALID_NUMBER: 'INVALID_NUMBER',
  INVALID_REQUEST: 'INVALID_REQUEST',
  INSUFFICIENT_DATA: 'INSUFFICIENT_DATA',
  DIVISION_BY_ZERO: 'DIVISION_BY_ZERO',
  INTERNAL_ERROR: 'INTERNAL_ERROR'
};

/**
 * A typed error the engine throws internally. CalculationEngine catches these
 * (and only these — anything else becomes INTERNAL_ERROR) and turns them into
 * the standard { success: false, error: {...} } shape. Never lets a raw
 * Apps Script exception/stack trace leak out to the caller.
 */
class EngineError extends Error {
  constructor(code, message, details) {
    super(message);
    this.name = 'EngineError';
    this.code = code || ERROR_CODES.INTERNAL_ERROR;
    this.details = details || {};
  }
}

