/*************************************************************************************
 * UNIVERSAL DYNAMIC CALCULATION ENGINE — Google Apps Script (V8 runtime)
 *
 * A generic, sheet-agnostic calculation & aggregation engine. It is driven entirely
 * by structured JSON requests (typically generated by an LLM) and returns
 * structured JSON results (typically consumed by an LLM to write a human-readable
 * report). No sheet name, column name, or business domain is hard-coded anywhere
 * in this file — everything is resolved dynamically at request time.
 *
 * PUBLIC API (call these from your own code / from a doGet or doPost handler):
 *
 *   calculate(request)              -> run one calculation, or a multi-calculation
 *                                       batch, or a COMPARE request
 *   validateRequest(request)        -> { valid: boolean, errors: string[] }
 *   getSheetSchema(sheetName)       -> headers + inferred types + row count
 *   getAvailableColumns(sheetName)  -> list of header names
 *   getSupportedOperations()        -> list of operation names + short docs
 *
 * ARCHITECTURE (each is a plain object "module" — GAS files share one global
 * scope, so namespacing this way keeps things organized without needing a
 * module system):
 *
 *   DataParser        - safe type parsing (numbers, dates, booleans)
 *   DateEngine        - relative date-range resolution (THIS_MONTH, LAST_7_DAYS, ...)
 *   SchemaEngine       - sheet access, bulk reads, header/column resolution, caching
 *   FilterEngine       - the dynamic filter/condition engine (AND/OR, nested groups)
 *   FormulaEngine      - a safe expression evaluator (NO eval()) for FORMULA ops
 *   AggregationEngine  - the OPERATIONS registry (SUM, AVERAGE, GROUP_BY, TOP_N, ...)
 *   ValidationEngine   - request validation
 *   ResultFormatter    - consistent success/error JSON shaping
 *   CalculationEngine  - orchestrates all of the above for calculate()
 *
 * See the bottom of this file for example requests and runnable test functions
 * (test_setupSampleData, runAllEngineTests, ...).
 *************************************************************************************/

// ============================================================================
// 0. GLOBAL CONFIG & ERROR CODES
// ============================================================================

const ENGINE_CONFIG = {
  DEFAULT_HEADER_ROW: 1,
  SCHEMA_CACHE_SECONDS: 300,      // how long inferred header/type info is cached
  SCHEMA_SAMPLE_ROWS: 100,        // rows sampled to infer a column's data type
  MAX_ROWS_HARD_LIMIT: 200000,    // safety ceiling so a runaway request can't hang
  MAX_WARNINGS_PER_ISSUE: 5,      // avoid flooding the response with repeat warnings
  DEFAULT_CURRENCY: 'INR',
  DEFAULT_WEEK_START: 1           // 0 = Sunday, 1 = Monday
};

const ERROR_CODES = {
  SHEET_NOT_FOUND: 'SHEET_NOT_FOUND',
  COLUMN_NOT_FOUND: 'COLUMN_NOT_FOUND',
  AMBIGUOUS_COLUMN: 'AMBIGUOUS_COLUMN',
  INVALID_OPERATION: 'INVALID_OPERATION',
  INVALID_OPERATOR: 'INVALID_OPERATOR',
  INVALID_DATE: 'INVALID_DATE',
  INVALID_NUMBER: 'INVALID_NUMBER',
  INVALID_REQUEST: 'INVALID_REQUEST',
  INSUFFICIENT_DATA: 'INSUFFICIENT_DATA',
  DIVISION_BY_ZERO: 'DIVISION_BY_ZERO',
  INTERNAL_ERROR: 'INTERNAL_ERROR'
};

/**
 * A typed error the engine throws internally. CalculationEngine catches these
 * (and only these — anything else becomes INTERNAL_ERROR) and turns them into
 * the standard { success: false, error: {...} } shape. Never lets a raw
 * Apps Script exception/stack trace leak out to the caller.
 */
class EngineError extends Error {
  constructor(code, message, details) {
    super(message);
    this.name = 'EngineError';
    this.code = code || ERROR_CODES.INTERNAL_ERROR;
    this.details = details || {};
  }
}

// ============================================================================
// 1. SMALL SHARED UTILITIES
// ============================================================================

const Util = {
  /** "A" -> 0, "B" -> 1, "AA" -> 26 (0-based). */
  columnLetterToIndex(letter) {
    let result = 0;
    const s = String(letter).toUpperCase();
    for (let i = 0; i < s.length; i++) {
      const code = s.charCodeAt(i) - 64; // 'A' = 1
      if (code < 1 || code > 26) return -1;
      result = result * 26 + code;
    }
    return result - 1;
  },

  /** 0 -> "A", 25 -> "Z", 26 -> "AA" */
  indexToColumnLetter(index) {
    let n = index + 1;
    let s = '';
    while (n > 0) {
      const rem = (n - 1) % 26;
      s = String.fromCharCode(65 + rem) + s;
      n = Math.floor((n - 1) / 26);
    }
    return s;
  },

  /** Normalizes a header for alias matching: "Sales Amount", "sales_amount",
   *  "SalesAmount" all normalize to "salesamount". */
  normalizeHeaderKey(str) {
    return String(str == null ? '' : str).toLowerCase().replace(/[^a-z0-9]/g, '');
  },

  isPlainObject(v) {
    return v !== null && typeof v === 'object' && !Array.isArray(v) && !(v instanceof Date);
  },

  isBlank(v) {
    return v === null || v === undefined || v === '';
  },

  normalizeValue(v) {
    return typeof v === 'string' ? v.trim() : v;
  },

  clamp(n, min, max) {
    return Math.max(min, Math.min(max, n));
  },

  round(n, decimals) {
    if (n === null || n === undefined || isNaN(n)) return n;
    const d = decimals === undefined ? 4 : decimals;
    const factor = Math.pow(10, d);
    return Math.round((n + Number.EPSILON) * factor) / factor;
  }
};

// ============================================================================
// 2. DATA PARSER — safe, non-lossy type parsing
// ============================================================================

const DataParser = {
  /**
   * Parses a raw cell value into a number. Returns null (never 0) when the
   * value cannot be confidently parsed — callers must treat null as "invalid/
   * skip", never coerce it to 0.
   * Handles: plain numbers, "$1,234.56", "₹1,00,000" (Indian grouping),
   * "1.234,56" (European), "45%", "(123.45)" (accounting negative), "USD 250".
   */
  parseNumberDetailed(raw) {
    const result = { value: null, isPercentage: false, isCurrency: false, currencySymbol: null };
    if (Util.isBlank(raw)) return result;
    if (typeof raw === 'number') {
      result.value = isFinite(raw) ? raw : null;
      return result;
    }
    if (raw instanceof Date || typeof raw === 'boolean') return result; // don't silently coerce
    if (typeof raw !== 'string') return result;

    let s = raw.trim();
    if (s === '') return result;

    const currencyMatch = s.match(/[₹$€£¥]|\b(?:RS|INR|USD|EUR|GBP|AED|CAD|AUD)\b\.?/i);
    if (currencyMatch) {
      result.isCurrency = true;
      result.currencySymbol = currencyMatch[0];
    }

    let negative = false;
    if (/^\(.*\)$/.test(s)) { negative = true; s = s.slice(1, -1).trim(); }

    if (/%\s*$/.test(s)) { result.isPercentage = true; s = s.replace(/%\s*$/, ''); }

    s = s.replace(/[₹$€£¥]/g, '')
         .replace(/\b(?:RS|INR|USD|EUR|GBP|AED|CAD|AUD)\b\.?/ig, '')
         .trim();

    if (/^-/.test(s)) { negative = true; s = s.slice(1).trim(); }
    if (/-$/.test(s)) { negative = true; s = s.slice(0, -1).trim(); }

    const hasComma = s.indexOf(',') > -1;
    const hasDot = s.indexOf('.') > -1;
    if (hasComma && hasDot) {
      if (s.lastIndexOf(',') > s.lastIndexOf('.')) {
        s = s.replace(/\./g, '').replace(',', '.'); // European: dot=thousands, comma=decimal
      } else {
        s = s.replace(/,/g, ''); // US/Indian: comma=thousands
      }
    } else if (hasComma && !hasDot) {
      if (/,\d{2,3}\b/.test(s)) {
        s = s.replace(/,/g, ''); // thousands grouping (incl. Indian lakh style)
      } else {
        s = s.replace(',', '.'); // decimal comma, e.g. "1,5"
      }
    }
    s = s.replace(/\s+/g, '');

    if (s === '' || !/^[0-9]+(\.[0-9]+)?$/.test(s)) {
      result.value = null;
      return result;
    }
    const num = parseFloat(s);
    if (isNaN(num)) { result.value = null; return result; }
    result.value = negative ? -num : num;
    return result;
  },

  parseNumber(raw) {
    return DataParser.parseNumberDetailed(raw).value;
  },

  /**
   * Parses a raw cell value into a Date. Returns null when unparseable.
   * Apps Script already returns JS Date objects for date-formatted cells, so
   * the common case is a pass-through; string fallback covers text-formatted
   * date columns (ISO, "DD/MM/YYYY", "MM/DD/YYYY", "DD-Mon-YYYY", etc.).
   */
  parseDate(raw) {
    if (Util.isBlank(raw)) return null;
    if (raw instanceof Date) return isNaN(raw.getTime()) ? null : new Date(raw.getTime());
    if (typeof raw === 'number') {
      // Google Sheets serial date (days since 1899-12-30). Only treat numbers
      // in a plausible date range as serial dates.
      if (!isFinite(raw) || raw < 1 || raw > 100000) return null;
      const epoch = new Date(Date.UTC(1899, 11, 30));
      const d = new Date(epoch.getTime() + raw * 86400000);
      return isNaN(d.getTime()) ? null : d;
    }
    if (typeof raw !== 'string') return null;
    const s = raw.trim();
    if (!s) return null;

    // Explicit ISO forms first.
    if (/^\d{4}-\d{1,2}-\d{1,2}(?:[T\s].*)?$/.test(s)) {
      const iso = new Date(s);
      if (!isNaN(iso.getTime())) return iso;
    }

    // Explicit DD/MM/YYYY or DD-MM-YYYY. This is the default business
    // convention for India and avoids JavaScript's US-centric ambiguous parsing.
    const m = s.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{2,4})$/);
    if (m) {
      let a = parseInt(m[1], 10), b = parseInt(m[2], 10), y = parseInt(m[3], 10);
      if (y < 100) y += (y < 70 ? 2000 : 1900);
      let day = a, month = b;
      if (a > 12 && b <= 12) { day = a; month = b; }
      else if (b > 12 && a <= 12) { day = b; month = a; }
      // Ambiguous values such as 03/04/2026 intentionally use DD/MM/YYYY.
      const candidate = new Date(y, month - 1, day);
      if (candidate.getFullYear() === y && candidate.getMonth() === month - 1 && candidate.getDate() === day) {
        return candidate;
      }
    }

    // Human-readable month names and other unambiguous formats.
    const generic = new Date(s);
    return isNaN(generic.getTime()) ? null : generic;
  },

  parseBoolean(raw) {
    if (typeof raw === 'boolean') return raw;
    if (Util.isBlank(raw)) return null;
    if (typeof raw === 'number') {
      if (raw === 1) return true;
      if (raw === 0) return false;
      return null;
    }
    if (typeof raw !== 'string') return null;
    const s = raw.trim().toLowerCase();
    if (['true', 'yes', 'y', '1'].includes(s)) return true;
    if (['false', 'no', 'n', '0'].includes(s)) return false;
    return null;
  },

  /** Trims strings, leaves other types as-is. Used before comparisons. */
  normalizeValue(raw) {
    if (typeof raw === 'string') return raw.trim();
    return raw;
  },

  /** Best-effort type classification for schema inference / display units. */
  detectType(raw) {
    if (Util.isBlank(raw)) return 'empty';
    if (raw instanceof Date) return 'date';
    if (typeof raw === 'boolean') return 'boolean';
    if (typeof raw === 'number') return 'number';
    if (typeof raw === 'string') {
      const b = DataParser.parseBoolean(raw);
      if (b !== null && /^(true|false|yes|no|y|n)$/i.test(raw.trim())) return 'boolean';
      const n = DataParser.parseNumberDetailed(raw);
      if (n.value !== null) return n.isPercentage ? 'percentage' : (n.isCurrency ? 'currency' : 'number');
      const d = DataParser.parseDate(raw);
      if (d !== null) return 'date';
      return 'text';
    }
    return 'text';
  }
};

// ============================================================================
// 3. DATE ENGINE — relative date range resolution
// ============================================================================

const DateEngine = {
  startOfDay(d) { const x = new Date(d); x.setHours(0, 0, 0, 0); return x; },
  endOfDay(d) { const x = new Date(d); x.setHours(23, 59, 59, 999); return x; },
  addDays(d, n) { const x = new Date(d); x.setDate(x.getDate() + n); return x; },

  startOfWeek(d) {
    const x = DateEngine.startOfDay(d);
    const day = x.getDay(); // 0=Sun..6=Sat
    const weekStart = ENGINE_CONFIG.DEFAULT_WEEK_START; // 1 = Monday
    const diff = (day - weekStart + 7) % 7;
    return DateEngine.addDays(x, -diff);
  },
  endOfWeek(d) { return DateEngine.endOfDay(DateEngine.addDays(DateEngine.startOfWeek(d), 6)); },

  startOfMonth(d) { return new Date(d.getFullYear(), d.getMonth(), 1, 0, 0, 0, 0); },
  endOfMonth(d) { return new Date(d.getFullYear(), d.getMonth() + 1, 0, 23, 59, 59, 999); },
  startOfYear(d) { return new Date(d.getFullYear(), 0, 1, 0, 0, 0, 0); },
  endOfYear(d) { return new Date(d.getFullYear(), 11, 31, 23, 59, 59, 999); },

  RELATIVE_OPERATORS: [
    'TODAY', 'YESTERDAY', 'TOMORROW', 'THIS_WEEK', 'LAST_WEEK', 'THIS_MONTH',
    'LAST_MONTH', 'THIS_YEAR', 'LAST_YEAR', 'LAST_7_DAYS', 'LAST_30_DAYS',
    'LAST_90_DAYS', 'YEAR_TO_DATE', 'MONTH_TO_DATE'
  ],

  /** Returns { start: Date, end: Date } (inclusive) for a named relative range. */
  getDateRangeForOperator(operator, now) {
    now = now || new Date();
    const E = DateEngine;
    switch (operator) {
      case 'TODAY': return { start: E.startOfDay(now), end: E.endOfDay(now) };
      case 'YESTERDAY': { const y = E.addDays(now, -1); return { start: E.startOfDay(y), end: E.endOfDay(y) }; }
      case 'TOMORROW': { const t = E.addDays(now, 1); return { start: E.startOfDay(t), end: E.endOfDay(t) }; }
      case 'THIS_WEEK': return { start: E.startOfWeek(now), end: E.endOfWeek(now) };
      case 'LAST_WEEK': { const lw = E.addDays(E.startOfWeek(now), -7); return { start: lw, end: E.endOfDay(E.addDays(lw, 6)) }; }
      case 'THIS_MONTH': return { start: E.startOfMonth(now), end: E.endOfMonth(now) };
      case 'LAST_MONTH': { const lm = new Date(now.getFullYear(), now.getMonth() - 1, 1); return { start: E.startOfMonth(lm), end: E.endOfMonth(lm) }; }
      case 'THIS_YEAR': return { start: E.startOfYear(now), end: E.endOfYear(now) };
      case 'LAST_YEAR': { const ly = new Date(now.getFullYear() - 1, 0, 1); return { start: E.startOfYear(ly), end: E.endOfYear(ly) }; }
      case 'LAST_7_DAYS': return { start: E.startOfDay(E.addDays(now, -6)), end: E.endOfDay(now) };
      case 'LAST_30_DAYS': return { start: E.startOfDay(E.addDays(now, -29)), end: E.endOfDay(now) };
      case 'LAST_90_DAYS': return { start: E.startOfDay(E.addDays(now, -89)), end: E.endOfDay(now) };
      case 'YEAR_TO_DATE': return { start: E.startOfYear(now), end: E.endOfDay(now) };
      case 'MONTH_TO_DATE': return { start: E.startOfMonth(now), end: E.endOfDay(now) };
      default:
        throw new EngineError(ERROR_CODES.INVALID_OPERATOR, `Unknown date operator "${operator}".`);
    }
  }
};

// ============================================================================
// 4. SCHEMA ENGINE — sheet access, bulk reads, column resolution, caching
// ============================================================================

const SchemaEngine = {
  _resolveSheet(sheetName) {
    if (!sheetName || typeof sheetName !== 'string') {
      throw new EngineError(ERROR_CODES.INVALID_REQUEST, '"sheetName" is required and must be a string.');
    }
    let ss = SpreadsheetApp.getActiveSpreadsheet();
    // Time-driven Telegram queue runs do not always have an active UI.
    // Fall back to the host spreadsheet recorded by installAgent().
    if (!ss && typeof getAgentProperty_ === 'function') {
      const hostId = getAgentProperty_('AI_HOST_SPREADSHEET_ID', '');
      if (hostId) ss = SpreadsheetApp.openById(hostId);
    }
    if (!ss) {
      throw new EngineError(
        ERROR_CODES.INVALID_REQUEST,
        'No host spreadsheet is available. Run installAgent() from the bound Google Sheet.'
      );
    }
    const sheet = ss.getSheetByName(sheetName);
    if (!sheet) {
      throw new EngineError(ERROR_CODES.SHEET_NOT_FOUND, `Sheet "${sheetName}" was not found in this spreadsheet.`);
    }
    return sheet;
  },

  /**
   * Bulk-reads a sheet's data in a single call (never loops getRange/getValue).
   * Returns { headers: string[], rows: any[][], rowNumbers: number[] } where
   * rowNumbers[i] is the 1-based sheet row that rows[i] came from (for
   * traceable warnings).
   */
  readSheetData(sheetName, headerRow) {
    const sheet = SchemaEngine._resolveSheet(sheetName);
    const hRow = headerRow || ENGINE_CONFIG.DEFAULT_HEADER_ROW;
    const lastRow = sheet.getLastRow();
    const lastCol = sheet.getLastColumn();
    if (lastRow < hRow || lastCol === 0) {
      return { headers: [], rows: [], rowNumbers: [], sheet };
    }
    // Read only the configured maximum number of data rows. The previous
    // implementation calculated a limit but still read the entire sheet,
    // which could defeat the safety ceiling on very large sheets.
    const numDataRows = Math.min(Math.max(lastRow - hRow, 0), ENGINE_CONFIG.MAX_ROWS_HARD_LIMIT);
    const rowsToRead = numDataRows + 1; // header + data
    const allValues = sheet.getRange(hRow, 1, rowsToRead, lastCol).getValues();
    const rawHeaders = allValues[0];
    const headers = rawHeaders.map((h, i) => (Util.isBlank(h) ? `Column${i + 1}` : String(h).trim()));
    const dataValues = allValues.slice(1);
    const rowNumbers = dataValues.map((_, i) => hRow + 1 + i);
    return { headers, rows: dataValues, rowNumbers, sheet };
  },

  /** Infers a simple type ('number' | 'currency' | 'percentage' | 'date' | 'boolean' | 'text' | 'empty') per column by majority vote over a sample. */
  inferColumnTypes(headers, rows) {
    const sampleSize = Math.min(rows.length, ENGINE_CONFIG.SCHEMA_SAMPLE_ROWS);
    return headers.map((h, colIdx) => {
      const counts = {};
      for (let r = 0; r < sampleSize; r++) {
        const t = DataParser.detectType(rows[r][colIdx]);
        counts[t] = (counts[t] || 0) + 1;
      }
      delete counts.empty; // don't let blanks dominate the type vote
      let best = 'text', bestCount = -1;
      Object.keys(counts).forEach(t => {
        if (counts[t] > bestCount) { best = t; bestCount = counts[t]; }
      });
      return { name: h, type: bestCount <= 0 ? 'text' : best };
    });
  },

  /**
   * Returns the sheet's schema, using a short-lived cache for the header/type
   * inference (not the data itself, which is always read fresh).
   */
  getSheetSchema(sheetName, headerRow) {
    const cache = CacheService.getScriptCache();
    const cacheKey = `schema_${sheetName}_${headerRow || ENGINE_CONFIG.DEFAULT_HEADER_ROW}`;
    const cached = cache.get(cacheKey);
    if (cached) {
      try { return JSON.parse(cached); } catch (e) { /* fall through and recompute */ }
    }
    const { headers, rows, sheet } = SchemaEngine.readSheetData(sheetName, headerRow);
    const schema = {
      sheetName,
      headers: SchemaEngine.inferColumnTypes(headers, rows),
      rowCount: rows.length
    };
    try {
      cache.put(cacheKey, JSON.stringify(schema), ENGINE_CONFIG.SCHEMA_CACHE_SECONDS);
    } catch (e) { /* cache is best-effort; ignore quota errors */ }
    return schema;
  },

  getAvailableColumns(sheetName) {
    const { headers } = SchemaEngine.readSheetData(sheetName);
    return headers;
  },

  /**
   * Resolves a column reference (header name, alias, column letter, or
   * 1-based column number) to a 0-based array index into a data row.
   */
  resolveColumnIndex(headers, columnRef) {
    if (columnRef === null || columnRef === undefined) {
      throw new EngineError(ERROR_CODES.COLUMN_NOT_FOUND, 'No column reference was provided.');
    }
    if (typeof columnRef === 'number') {
      const idx = columnRef - 1; // 1-based -> 0-based, consistent with column letters
      if (idx < 0 || idx >= headers.length) {
        throw new EngineError(ERROR_CODES.COLUMN_NOT_FOUND, `Column index ${columnRef} is out of range (sheet has ${headers.length} columns).`);
      }
      return idx;
    }
    if (typeof columnRef !== 'string') {
      throw new EngineError(ERROR_CODES.COLUMN_NOT_FOUND, `Invalid column reference: ${JSON.stringify(columnRef)}`);
    }
    const raw = columnRef.trim();

    // 1) exact case-insensitive header match
    let idx = headers.findIndex(h => h.toLowerCase() === raw.toLowerCase());
    if (idx > -1) return idx;

    // 2) normalized alias match ("Sales Amount" == "sales_amount" == "SalesAmount")
    const normalizedTarget = Util.normalizeHeaderKey(raw);
    const normalizedMatches = headers.reduce((acc, h, i) => {
      if (Util.normalizeHeaderKey(h) === normalizedTarget) acc.push(i);
      return acc;
    }, []);
    if (normalizedMatches.length === 1) return normalizedMatches[0];
    if (normalizedMatches.length > 1) {
      throw new EngineError(ERROR_CODES.AMBIGUOUS_COLUMN,
        `Column reference "${columnRef}" matches multiple columns: ${normalizedMatches.map(i => headers[i]).join(', ')}. Use an exact header, letter, or index.`);
    }

    // 3) column letter, e.g. "B", "AA" — only if it isn't itself a real header name
    if (/^[A-Za-z]+$/.test(raw)) {
      const letterIdx = Util.columnLetterToIndex(raw);
      if (letterIdx > -1 && letterIdx < headers.length) return letterIdx;
    }

    throw new EngineError(ERROR_CODES.COLUMN_NOT_FOUND, `Column "${columnRef}" was not found. Available columns: ${headers.join(', ')}`);
  }
};

// ============================================================================
// 5. FILTER ENGINE — dynamic condition evaluation
// ============================================================================

const FilterEngine = {
  SUPPORTED_OPERATORS: [
    '=', '==', '!=', '<>', '>', '<', '>=', '<=',
    'contains', 'not_contains', 'starts_with', 'ends_with', 'equals_ignore_case',
    'in', 'not_in', 'between', 'is_empty', 'is_not_empty'
  ].concat(DateEngine.RELATIVE_OPERATORS),

  /**
   * filterSpec may be:
   *  - undefined/null                         -> no filtering
   *  - an array of filter objects             -> implicit AND
   *  - { logic: 'AND'|'OR', filters: [...] }  -> explicit group, filters may
   *                                               themselves be nested groups
   * Returns the subset of rows that match.
   */
  applyFilters(rows, headers, filterSpec) {
    return FilterEngine.applyFiltersWithRowNumbers(rows, headers, filterSpec, null).rows;
  },

  applyFiltersWithRowNumbers(rows, headers, filterSpec, rowNumbers) {
    const sourceNumbers = rowNumbers || rows.map((_, i) => i + 1);
    if (!filterSpec || (Array.isArray(filterSpec) && filterSpec.length === 0)) {
      return { rows: rows.slice(), rowNumbers: sourceNumbers.slice() };
    }
    const group = Array.isArray(filterSpec) ? { logic: 'AND', filters: filterSpec } : filterSpec;
    const matchedRows = [];
    const matchedNumbers = [];
    rows.forEach((row, i) => {
      if (FilterEngine._evaluateGroup(row, headers, group)) {
        matchedRows.push(row);
        matchedNumbers.push(sourceNumbers[i]);
      }
    });
    return { rows: matchedRows, rowNumbers: matchedNumbers };
  },

  _evaluateGroup(row, headers, group) {
    const logic = (group.logic || 'AND').toUpperCase();
    const filters = group.filters || [];
    if (filters.length === 0) return true;
    const evalOne = (f) => (f.filters ? FilterEngine._evaluateGroup(row, headers, f)
                                       : FilterEngine._evaluateSingle(row, headers, f));
    return logic === 'OR' ? filters.some(evalOne) : filters.every(evalOne);
  },

  _evaluateSingle(row, headers, filter) {
    if (!filter || !filter.column) {
      throw new EngineError(ERROR_CODES.INVALID_REQUEST, `Filter is missing a "column": ${JSON.stringify(filter)}`);
    }
    const colIdx = SchemaEngine.resolveColumnIndex(headers, filter.column);
    const cellRaw = row[colIdx];
    const rawOperator = filter.operator || '=';
    const operator = typeof rawOperator === 'string'
      ? (['=', '==', '!=', '<>', '>', '<', '>=', '<='].includes(rawOperator) ? rawOperator : rawOperator.toUpperCase())
      : rawOperator;

    if (DateEngine.RELATIVE_OPERATORS.includes(operator)) {
      const cellDate = DataParser.parseDate(cellRaw);
      if (cellDate === null) return false;
      const range = DateEngine.getDateRangeForOperator(operator);
      return cellDate >= range.start && cellDate <= range.end;
    }

    switch (operator) {
      case 'IS_EMPTY': return Util.isBlank(cellRaw) || String(cellRaw).trim() === '';
      case 'IS_NOT_EMPTY': return !Util.isBlank(cellRaw) && String(cellRaw).trim() !== '';
      case 'BETWEEN': {
        const [lo, hi] = filter.value || [];
        return FilterEngine._compareBetween(cellRaw, lo, hi);
      }
      case 'IN': {
        const list = Array.isArray(filter.value) ? filter.value : [filter.value];
        return list.some(v => FilterEngine._looseEquals(cellRaw, v));
      }
      case 'NOT_IN': {
        const list = Array.isArray(filter.value) ? filter.value : [filter.value];
        return !list.some(v => FilterEngine._looseEquals(cellRaw, v));
      }
      case 'CONTAINS':
        return String(cellRaw ?? '').toLowerCase().includes(String(filter.value ?? '').toLowerCase());
      case 'NOT_CONTAINS':
        return !String(cellRaw ?? '').toLowerCase().includes(String(filter.value ?? '').toLowerCase());
      case 'STARTS_WITH':
        return String(cellRaw ?? '').toLowerCase().startsWith(String(filter.value ?? '').toLowerCase());
      case 'ENDS_WITH':
        return String(cellRaw ?? '').toLowerCase().endsWith(String(filter.value ?? '').toLowerCase());
      case 'EQUALS_IGNORE_CASE':
        return String(cellRaw ?? '').toLowerCase() === String(filter.value ?? '').toLowerCase();
      case '=':
      case '==':
        return FilterEngine._looseEquals(cellRaw, filter.value);
      case '!=':
      case '<>':
        return !FilterEngine._looseEquals(cellRaw, filter.value);
      case '>': case '<': case '>=': case '<=':
        return FilterEngine._compareOrdered(cellRaw, filter.value, operator);
      default:
        throw new EngineError(ERROR_CODES.INVALID_OPERATOR, `Unsupported filter operator "${operator}".`);
    }
  },

  /** Compares dates only when both operands clearly look like dates. */
  _looseEquals(a, b) {
    const da = DataParser.parseDate(a), db = DataParser.parseDate(b);
    if (FilterEngine._isDateLike(a) && FilterEngine._isDateLike(b) && da && db) {
      return da.getTime() === db.getTime();
    }
    const na = DataParser.parseNumber(a), nb = DataParser.parseNumber(b);
    if (na !== null && nb !== null && typeof a !== 'boolean' && typeof b !== 'boolean') return na === nb;
    return Util.normalizeValue(a) === Util.normalizeValue(b) ||
           String(a ?? '').toLowerCase() === String(b ?? '').toLowerCase();
  },

  _isDateLike(v) {
    if (v instanceof Date) return true;
    if (typeof v !== 'string') return false;
    const s = v.trim();
    return /^\d{4}-\d{1,2}-\d{1,2}(?:[T\s].*)?$/.test(s) ||
           /^\d{1,2}[\/\-.]\d{1,2}[\/\-.]\d{2,4}$/.test(s) ||
           /\b(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\b/i.test(s);
  },

  _compareOrdered(cellRaw, target, operator) {
    let a, b;
    if (FilterEngine._isDateLike(cellRaw) && FilterEngine._isDateLike(target)) {
      a = DataParser.parseDate(cellRaw);
      b = DataParser.parseDate(target);
    } else {
      a = DataParser.parseNumber(cellRaw);
      b = DataParser.parseNumber(target);
    }
    if (a === null || b === null) return false;
    switch (operator) {
      case '>': return a > b;
      case '<': return a < b;
      case '>=': return a >= b;
      case '<=': return a <= b;
    }
    return false;
  },

  _compareBetween(cellRaw, lo, hi) {
    if (FilterEngine._isDateLike(cellRaw) && FilterEngine._isDateLike(lo) && FilterEngine._isDateLike(hi)) {
      const d = DataParser.parseDate(cellRaw);
      const loD = DataParser.parseDate(lo), hiD = DataParser.parseDate(hi);
      if (d && loD && hiD) return d >= DateEngine.startOfDay(loD) && d <= DateEngine.endOfDay(hiD);
    }
    const n = DataParser.parseNumber(cellRaw);
    const loN = DataParser.parseNumber(lo), hiN = DataParser.parseNumber(hi);
    if (n !== null && loN !== null && hiN !== null) return n >= loN && n <= hiN;
    return false;
  }

};

// ============================================================================
// 6. FORMULA ENGINE — safe expression evaluator (NO eval())
// ============================================================================

const FormulaEngine = {
  /** "Revenue - Cost" + headers -> { substituted: "$0$ - $1$", placeholderToHeader } */
  substituteHeaders(formula, headers) {
    const indexed = headers.map((h, i) => ({ h, i })).sort((a, b) => b.h.length - a.h.length);
    const placeholderToHeader = {};
    let out = formula;
    indexed.forEach(({ h, i }) => {
      const placeholder = `$${i}$`;
      placeholderToHeader[placeholder] = h;
      const escaped = h.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const re = new RegExp('\\b' + escaped + '\\b', 'gi');
      out = out.replace(re, placeholder);
    });
    return { substituted: out, placeholderToHeader };
  },

  tokenize(expr) {
    const tokens = [];
    let i = 0;
    const n = expr.length;
    while (i < n) {
      const c = expr[i];
      if (/\s/.test(c)) { i++; continue; }
      if (/[0-9.]/.test(c)) {
        let j = i;
        while (j < n && /[0-9.]/.test(expr[j])) j++;
        const numStr = expr.slice(i, j);
        if ((numStr.match(/\./g) || []).length > 1) {
          throw new EngineError(ERROR_CODES.INVALID_REQUEST, `Invalid number literal "${numStr}" in formula.`);
        }
        tokens.push({ type: 'NUMBER', value: parseFloat(numStr) });
        i = j;
        continue;
      }
      if (c === '$' && /[0-9]/.test(expr[i + 1] || '')) {
        let j = i + 1;
        while (j < n && /[0-9]/.test(expr[j])) j++;
        if (expr[j] !== '$') throw new EngineError(ERROR_CODES.INVALID_REQUEST, 'Malformed column placeholder in formula.');
        tokens.push({ type: 'PLACEHOLDER', value: '$' + expr.slice(i + 1, j) + '$' });
        i = j + 1;
        continue;
      }
      if ('+-*/()'.includes(c)) { tokens.push({ type: c }); i++; continue; }
      throw new EngineError(ERROR_CODES.INVALID_REQUEST, `Unexpected character "${c}" in formula. Only column names, numbers, and + - * / ( ) are allowed.`);
    }
    return tokens;
  },

  parse(tokens) {
    let pos = 0;
    const peek = () => tokens[pos];
    const consume = (type) => {
      const t = tokens[pos];
      if (!t || (type && t.type !== type)) {
        throw new EngineError(ERROR_CODES.INVALID_REQUEST, `Malformed formula near position ${pos}.`);
      }
      pos++;
      return t;
    };
    function parseExpression() {
      let node = parseTerm();
      while (peek() && (peek().type === '+' || peek().type === '-')) {
        const op = consume().type;
        node = { type: 'BinOp', op, left: node, right: parseTerm() };
      }
      return node;
    }
    function parseTerm() {
      let node = parseUnary();
      while (peek() && (peek().type === '*' || peek().type === '/')) {
        const op = consume().type;
        node = { type: 'BinOp', op, left: node, right: parseUnary() };
      }
      return node;
    }
    function parseUnary() {
      if (peek() && peek().type === '-') { consume('-'); return { type: 'Unary', op: '-', operand: parseUnary() }; }
      if (peek() && peek().type === '+') { consume('+'); return parseUnary(); }
      return parsePrimary();
    }
    function parsePrimary() {
      const t = peek();
      if (!t) throw new EngineError(ERROR_CODES.INVALID_REQUEST, 'Formula ended unexpectedly.');
      if (t.type === 'NUMBER') { consume(); return { type: 'Number', value: t.value }; }
      if (t.type === 'PLACEHOLDER') { consume(); return { type: 'Placeholder', name: t.value }; }
      if (t.type === '(') { consume('('); const node = parseExpression(); consume(')'); return node; }
      throw new EngineError(ERROR_CODES.INVALID_REQUEST, `Unexpected token in formula: "${t.type}"`);
    }
    const result = parseExpression();
    if (pos !== tokens.length) throw new EngineError(ERROR_CODES.INVALID_REQUEST, 'Formula has trailing, unparseable content.');
    return result;
  },

  evaluate(node, values) {
    switch (node.type) {
      case 'Number': return node.value;
      case 'Placeholder': {
        const v = values[node.name];
        if (v === null || v === undefined || typeof v !== 'number' || isNaN(v)) return null; // caller decides how to handle
        return v;
      }
      case 'Unary': {
        const v = FormulaEngine.evaluate(node.operand, values);
        if (v === null) return null;
        return node.op === '-' ? -v : v;
      }
      case 'BinOp': {
        const l = FormulaEngine.evaluate(node.left, values);
        const r = FormulaEngine.evaluate(node.right, values);
        if (l === null || r === null) return null;
        switch (node.op) {
          case '+': return l + r;
          case '-': return l - r;
          case '*': return l * r;
          case '/':
            if (r === 0) throw new EngineError(ERROR_CODES.DIVISION_BY_ZERO, 'Formula attempted to divide by zero.');
            return l / r;
        }
      }
    }
    throw new EngineError(ERROR_CODES.INTERNAL_ERROR, 'Unrecognized formula AST node.');
  },

  /** Compiles a formula against a set of headers, returning a reusable per-row evaluator. */
  compile(formula, headers) {
    if (!formula || typeof formula !== 'string') {
      throw new EngineError(ERROR_CODES.INVALID_REQUEST, '"formula" must be a non-empty string.');
    }
    const { substituted, placeholderToHeader } = FormulaEngine.substituteHeaders(formula, headers);
    const ast = FormulaEngine.parse(FormulaEngine.tokenize(substituted));
    const headerToColIdx = {};
    Object.keys(placeholderToHeader).forEach(ph => {
      headerToColIdx[ph] = SchemaEngine.resolveColumnIndex(headers, placeholderToHeader[ph]);
    });
    return {
      run(row) {
        const values = {};
        Object.keys(headerToColIdx).forEach(ph => {
          values[ph] = DataParser.parseNumber(row[headerToColIdx[ph]]);
        });
        return FormulaEngine.evaluate(ast, values); // number, or null if any operand was missing/invalid
      }
    };
  }
};

// ============================================================================
// 7. AGGREGATION ENGINE — the OPERATIONS registry
// ============================================================================

const AggregationHelpers = {
  /** Bulk-extracts a numeric column from rows, tracking data-quality metadata. */
  extractNumeric(rows, colIdx, headerName, rowNumbers) {
    const values = [];
    let invalidCount = 0, emptyCount = 0;
    const warnings = [];
    rows.forEach((row, i) => {
      const raw = row[colIdx];
      if (Util.isBlank(raw)) { emptyCount++; return; }
      const num = DataParser.parseNumber(raw);
      if (num === null) {
        invalidCount++;
        if (warnings.length < ENGINE_CONFIG.MAX_WARNINGS_PER_ISSUE) {
          const rn = rowNumbers ? rowNumbers[i] : i + 1;
          warnings.push(`Row ${rn}: value "${raw}" in column "${headerName}" is not a valid number and was skipped.`);
        }
        return;
      }
      values.push(num);
    });
    if (invalidCount > ENGINE_CONFIG.MAX_WARNINGS_PER_ISSUE) {
      warnings.push(`...and ${invalidCount - ENGINE_CONFIG.MAX_WARNINGS_PER_ISSUE} more invalid values in column "${headerName}" (skipped).`);
    }
    return { values, invalidCount, emptyCount, warnings };
  },

  mean(values) { return values.length ? values.reduce((a, b) => a + b, 0) / values.length : null; },

  median(values) {
    if (!values.length) return null;
    const s = values.slice().sort((a, b) => a - b);
    const mid = Math.floor(s.length / 2);
    return s.length % 2 ? s[mid] : (s[mid - 1] + s[mid]) / 2;
  },

  mode(values) {
    if (!values.length) return null;
    const counts = new Map();
    values.forEach(v => counts.set(v, (counts.get(v) || 0) + 1));
    let best = null, bestCount = -1;
    counts.forEach((c, v) => { if (c > bestCount) { best = v; bestCount = c; } });
    return best;
  },

  variance(values, population) {
    if (values.length < (population ? 1 : 2)) return null;
    const m = AggregationHelpers.mean(values);
    const sumSq = values.reduce((acc, v) => acc + (v - m) * (v - m), 0);
    return sumSq / (population ? values.length : values.length - 1);
  },

  /** Groups rows by one or more columns. Returns Map<key, {labelParts, rows}>. */
  groupRows(rows, groupColIndices) {
    const map = new Map();
    rows.forEach(row => {
      const labelParts = groupColIndices.map(idx => {
        const v = row[idx];
        return Util.isBlank(v) ? '(blank)' : String(v instanceof Date ? v.toISOString().slice(0, 10) : v).trim();
      });
      const key = labelParts.join(' | ');
      if (!map.has(key)) map.set(key, { labelParts, rows: [] });
      map.get(key).rows.push(row);
    });
    return map;
  },

  /** Aggregates one group's rows with a named aggregation over a numeric column. */
  aggregateGroup(groupRowsArr, colIdx, headerName, aggregation) {
    if (aggregation === 'COUNT') return groupRowsArr.length;
    const { values } = AggregationHelpers.extractNumeric(groupRowsArr, colIdx, headerName);
    switch (aggregation) {
      case 'SUM': return values.reduce((a, b) => a + b, 0);
      case 'AVERAGE': return AggregationHelpers.mean(values);
      case 'MIN': return values.length ? Math.min(...values) : null;
      case 'MAX': return values.length ? Math.max(...values) : null;
      case 'MEDIAN': return AggregationHelpers.median(values);
      default: return values.reduce((a, b) => a + b, 0);
    }
  }
};

/**
 * Every entry in OPERATIONS is a function(ctx) -> { value, unit, rowsProcessed,
 * warnings, metadata }. ctx = { rows, headers, rowNumbers, params, allRows,
 * priorResults, sheetName }. Adding a new operation only requires adding a new
 * entry here — nothing else in the engine needs to change.
 */
const OPERATIONS = {

  SUM(ctx) {
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const headerName = ctx.headers[colIdx];
    const { values, invalidCount, emptyCount, warnings } = AggregationHelpers.extractNumeric(ctx.rows, colIdx, headerName, ctx.rowNumbers);
    return {
      value: Util.round(values.reduce((a, b) => a + b, 0)),
      unit: 'number', rowsProcessed: values.length, warnings,
      metadata: { emptyCount, invalidCount }
    };
  },

  AVERAGE(ctx) {
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const headerName = ctx.headers[colIdx];
    const { values, invalidCount, emptyCount, warnings } = AggregationHelpers.extractNumeric(ctx.rows, colIdx, headerName, ctx.rowNumbers);
    if (!values.length) throw new EngineError(ERROR_CODES.INSUFFICIENT_DATA, `No valid numeric values in column "${headerName}" to average.`);
    return { value: Util.round(AggregationHelpers.mean(values)), unit: 'number', rowsProcessed: values.length, warnings, metadata: { emptyCount, invalidCount } };
  },

  COUNT(ctx) {
    return { value: ctx.rows.length, unit: 'count', rowsProcessed: ctx.rows.length, warnings: [], metadata: {} };
  },

  COUNT_NUMERIC(ctx) {
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const { values, warnings } = AggregationHelpers.extractNumeric(ctx.rows, colIdx, ctx.headers[colIdx], ctx.rowNumbers);
    return { value: values.length, unit: 'count', rowsProcessed: ctx.rows.length, warnings, metadata: {} };
  },

  COUNT_NON_EMPTY(ctx) {
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const count = ctx.rows.filter(r => !Util.isBlank(r[colIdx]) && String(r[colIdx]).trim() !== '').length;
    return { value: count, unit: 'count', rowsProcessed: ctx.rows.length, warnings: [], metadata: {} };
  },

  COUNT_EMPTY(ctx) {
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const count = ctx.rows.filter(r => Util.isBlank(r[colIdx]) || String(r[colIdx]).trim() === '').length;
    return { value: count, unit: 'count', rowsProcessed: ctx.rows.length, warnings: [], metadata: {} };
  },

  COUNT_DISTINCT(ctx) {
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const set = new Set();
    ctx.rows.forEach(r => { if (!Util.isBlank(r[colIdx])) set.add(String(Util.normalizeValue(r[colIdx])).toLowerCase()); });
    return { value: set.size, unit: 'count', rowsProcessed: ctx.rows.length, warnings: [], metadata: {} };
  },

  COUNT_IF(ctx) {
    const conditionColRef = ctx.params.conditionColumn || ctx.params.valueColumn;
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam({ x: conditionColRef }, 'x'));
    const condition = requireParam(ctx.params, 'condition');
    const matches = ctx.rows.filter(r => FilterEngine._evaluateSingle(r, ctx.headers, { column: ctx.headers[colIdx], operator: condition.operator, value: condition.value }));
    return { value: matches.length, unit: 'count', rowsProcessed: ctx.rows.length, warnings: [], metadata: {} };
  },

  COUNT_DISTINCT_IF(ctx) {
    const condition = requireParam(ctx.params, 'condition');
    const conditionColRef = ctx.params.conditionColumn || ctx.params.valueColumn;
    const distinctColRef = ctx.params.distinctColumn || ctx.params.valueColumn;
    const distinctColIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam({ x: distinctColRef }, 'x'));
    const matches = ctx.rows.filter(r => FilterEngine._evaluateSingle(r, ctx.headers, { column: conditionColRef, operator: condition.operator, value: condition.value }));
    const set = new Set();
    matches.forEach(r => { if (!Util.isBlank(r[distinctColIdx])) set.add(String(Util.normalizeValue(r[distinctColIdx])).toLowerCase()); });
    return { value: set.size, unit: 'count', rowsProcessed: matches.length, warnings: [], metadata: {} };
  },

  MIN(ctx) {
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const { values, warnings } = AggregationHelpers.extractNumeric(ctx.rows, colIdx, ctx.headers[colIdx], ctx.rowNumbers);
    if (!values.length) throw new EngineError(ERROR_CODES.INSUFFICIENT_DATA, `No valid numeric values in column "${ctx.headers[colIdx]}".`);
    return { value: Math.min(...values), unit: 'number', rowsProcessed: values.length, warnings, metadata: {} };
  },

  MAX(ctx) {
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const { values, warnings } = AggregationHelpers.extractNumeric(ctx.rows, colIdx, ctx.headers[colIdx], ctx.rowNumbers);
    if (!values.length) throw new EngineError(ERROR_CODES.INSUFFICIENT_DATA, `No valid numeric values in column "${ctx.headers[colIdx]}".`);
    return { value: Math.max(...values), unit: 'number', rowsProcessed: values.length, warnings, metadata: {} };
  },

  MEDIAN(ctx) {
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const { values, warnings } = AggregationHelpers.extractNumeric(ctx.rows, colIdx, ctx.headers[colIdx], ctx.rowNumbers);
    if (!values.length) throw new EngineError(ERROR_CODES.INSUFFICIENT_DATA, `No valid numeric values in column "${ctx.headers[colIdx]}".`);
    return { value: Util.round(AggregationHelpers.median(values)), unit: 'number', rowsProcessed: values.length, warnings, metadata: {} };
  },

  MODE(ctx) {
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const { values, warnings } = AggregationHelpers.extractNumeric(ctx.rows, colIdx, ctx.headers[colIdx], ctx.rowNumbers);
    if (!values.length) throw new EngineError(ERROR_CODES.INSUFFICIENT_DATA, `No valid numeric values in column "${ctx.headers[colIdx]}".`);
    return { value: AggregationHelpers.mode(values), unit: 'number', rowsProcessed: values.length, warnings, metadata: {} };
  },

  RANGE(ctx) {
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const { values, warnings } = AggregationHelpers.extractNumeric(ctx.rows, colIdx, ctx.headers[colIdx], ctx.rowNumbers);
    if (!values.length) throw new EngineError(ERROR_CODES.INSUFFICIENT_DATA, `No valid numeric values in column "${ctx.headers[colIdx]}".`);
    return { value: Util.round(Math.max(...values) - Math.min(...values)), unit: 'number', rowsProcessed: values.length, warnings, metadata: {} };
  },

  SUM_SQUARES(ctx) {
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const { values, warnings } = AggregationHelpers.extractNumeric(ctx.rows, colIdx, ctx.headers[colIdx], ctx.rowNumbers);
    return { value: Util.round(values.reduce((a, b) => a + b * b, 0)), unit: 'number', rowsProcessed: values.length, warnings, metadata: {} };
  },

  STANDARD_DEVIATION(ctx) {
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const { values, warnings } = AggregationHelpers.extractNumeric(ctx.rows, colIdx, ctx.headers[colIdx], ctx.rowNumbers);
    const v = AggregationHelpers.variance(values, !!ctx.params.population);
    if (v === null) throw new EngineError(ERROR_CODES.INSUFFICIENT_DATA, 'Not enough valid numeric values to compute standard deviation (need at least 2 for a sample).');
    return { value: Util.round(Math.sqrt(v)), unit: 'number', rowsProcessed: values.length, warnings, metadata: { population: !!ctx.params.population } };
  },

  VARIANCE(ctx) {
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const { values, warnings } = AggregationHelpers.extractNumeric(ctx.rows, colIdx, ctx.headers[colIdx], ctx.rowNumbers);
    const v = AggregationHelpers.variance(values, !!ctx.params.population);
    if (v === null) throw new EngineError(ERROR_CODES.INSUFFICIENT_DATA, 'Not enough valid numeric values to compute variance (need at least 2 for a sample).');
    return { value: Util.round(v), unit: 'number', rowsProcessed: values.length, warnings, metadata: { population: !!ctx.params.population } };
  },

  PERCENTAGE(ctx) {
    const value = resolveOperand(requireParam(ctx.params, 'value'), ctx);
    const total = resolveOperand(requireParam(ctx.params, 'total'), ctx);
    if (total === 0) throw new EngineError(ERROR_CODES.DIVISION_BY_ZERO, '"total" is zero.');
    return { value: Util.round((value / total) * 100, 2), unit: 'percentage', rowsProcessed: ctx.rows.length, warnings: [], metadata: { rawValue: value, total } };
  },

  PERCENTAGE_OF_TOTAL(ctx) {
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const headerName = ctx.headers[colIdx];
    const filtered = AggregationHelpers.extractNumeric(ctx.rows, colIdx, headerName, ctx.rowNumbers);
    const grand = AggregationHelpers.extractNumeric(ctx.allRows, colIdx, headerName);
    const filteredSum = filtered.values.reduce((a, b) => a + b, 0);
    const grandSum = grand.values.reduce((a, b) => a + b, 0);
    if (grandSum === 0) throw new EngineError(ERROR_CODES.DIVISION_BY_ZERO, `Grand total for column "${headerName}" is zero.`);
    return {
      value: Util.round((filteredSum / grandSum) * 100, 2), unit: 'percentage', rowsProcessed: filtered.values.length,
      warnings: filtered.warnings, metadata: { filteredSum: Util.round(filteredSum), grandTotal: Util.round(grandSum) }
    };
  },

  RATIO(ctx) {
    const numerator = resolveOperand(requireParam(ctx.params, 'numerator'), ctx);
    const denominator = resolveOperand(requireParam(ctx.params, 'denominator'), ctx);
    if (denominator === 0) throw new EngineError(ERROR_CODES.DIVISION_BY_ZERO, 'Denominator resolved to zero.');
    return { value: Util.round(numerator / denominator, 4), unit: 'ratio', rowsProcessed: ctx.rows.length, warnings: [], metadata: { numerator, denominator } };
  },

  RATE(ctx) {
    const numerator = resolveOperand(requireParam(ctx.params, 'numerator'), ctx);
    const denominator = resolveOperand(requireParam(ctx.params, 'denominator'), ctx);
    if (denominator === 0) throw new EngineError(ERROR_CODES.DIVISION_BY_ZERO, 'Denominator resolved to zero.');
    return { value: Util.round((numerator / denominator) * 100, 2), unit: 'percentage', rowsProcessed: ctx.rows.length, warnings: [], metadata: { numerator, denominator } };
  },

  CHANGE(ctx) {
    const { current, previous } = resolveComparablePair(ctx);
    return { value: Util.round(current - previous), unit: 'number', rowsProcessed: ctx.rows.length, warnings: [], metadata: { current, previous } };
  },

  CHANGE_PERCENTAGE(ctx) {
    const { current, previous } = resolveComparablePair(ctx);
    if (previous === 0) throw new EngineError(ERROR_CODES.DIVISION_BY_ZERO, '"previous" resolved to zero — percentage change is undefined.');
    return { value: Util.round(((current - previous) / Math.abs(previous)) * 100, 2), unit: 'percentage', rowsProcessed: ctx.rows.length, warnings: [], metadata: { current, previous } };
  },

  GROWTH_PERCENTAGE(ctx) { return OPERATIONS.CHANGE_PERCENTAGE(ctx); },

  WEIGHTED_AVERAGE(ctx) {
    const valColIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const weightColIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'weightColumn'));
    let weightedSum = 0, weightSum = 0, processed = 0;
    const warnings = [];
    ctx.rows.forEach((row, i) => {
      const v = DataParser.parseNumber(row[valColIdx]);
      const w = DataParser.parseNumber(row[weightColIdx]);
      if (v === null || w === null) {
        if (warnings.length < ENGINE_CONFIG.MAX_WARNINGS_PER_ISSUE) {
          warnings.push(`Row ${ctx.rowNumbers[i]}: missing/invalid value or weight — skipped.`);
        }
        return;
      }
      weightedSum += v * w; weightSum += w; processed++;
    });
    if (weightSum === 0) throw new EngineError(ERROR_CODES.DIVISION_BY_ZERO, 'Sum of weights is zero.');
    return { value: Util.round(weightedSum / weightSum), unit: 'number', rowsProcessed: processed, warnings, metadata: {} };
  },

  FIRST(ctx) { return firstOrLast(ctx, 'first'); },
  LAST(ctx) { return firstOrLast(ctx, 'last'); },

  UNIQUE_VALUES(ctx) {
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    const counts = new Map();
    ctx.rows.forEach(row => {
      const raw = row[colIdx];
      if (Util.isBlank(raw)) return;
      const key = String(Util.normalizeValue(raw));
      counts.set(key, (counts.get(key) || 0) + 1);
    });
    let list = Array.from(counts.entries()).map(([value, count]) => ({ value, count }));
    const sortBy = ctx.params.sortBy || 'count';
    list.sort((a, b) => sortBy === 'value' ? String(a.value).localeCompare(String(b.value)) : b.count - a.count);
    return { value: list, unit: 'list', rowsProcessed: ctx.rows.length, warnings: [], metadata: { distinctCount: list.length } };
  },

  GROUP_BY(ctx) { return groupOperation(ctx, ctx.params.valueColumn ? 'SUM' : 'COUNT'); },
  GROUP_SUM(ctx) { return groupOperation(ctx, 'SUM'); },
  GROUP_AVERAGE(ctx) { return groupOperation(ctx, 'AVERAGE'); },
  GROUP_COUNT(ctx) { return groupOperation(ctx, 'COUNT'); },
  GROUP_MIN(ctx) { return groupOperation(ctx, 'MIN'); },
  GROUP_MAX(ctx) { return groupOperation(ctx, 'MAX'); },

  TOP_N(ctx) { return topBottomN(ctx, 'desc'); },
  BOTTOM_N(ctx) { return topBottomN(ctx, 'asc'); },

  RANK(ctx) {
    const aggregation = (ctx.params.aggregation || 'SUM').toUpperCase();
    const order = (ctx.params.order || 'desc').toLowerCase();
    const groupResult = groupOperation(ctx, aggregation);
    const sorted = groupResult.value.slice().sort((a, b) => order === 'asc' ? a.value - b.value : b.value - a.value);
    sorted.forEach((g, i) => { g.rank = i + 1; });
    let identified = null;
    if (ctx.params.identify) {
      identified = sorted.find(g => g.group.toLowerCase() === String(ctx.params.identify).toLowerCase()) || null;
    }
    return { value: sorted, unit: 'list', rowsProcessed: ctx.rows.length, warnings: groupResult.warnings, metadata: { identified } };
  },

  FORMULA(ctx) {
    const formula = requireParam(ctx.params, 'formula');
    const aggregate = (ctx.params.aggregate || 'SUM').toUpperCase();
    const compiled = FormulaEngine.compile(formula, ctx.headers);
    const warnings = [];

    if (ctx.params.groupBy) {
      const groupCols = Array.isArray(ctx.params.groupBy) ? ctx.params.groupBy : [ctx.params.groupBy];
      const groupColIndices = groupCols.map(c => SchemaEngine.resolveColumnIndex(ctx.headers, c));
      const groups = AggregationHelpers.groupRows(ctx.rows, groupColIndices);
      const result = [];
      groups.forEach(({ labelParts, rows }) => {
        const perRow = rows.map(r => compiled.run(r)).filter(v => v !== null);
        if (!perRow.length) return;
        result.push({ group: labelParts.length > 1 ? labelParts.join(' | ') : labelParts[0], value: Util.round(aggregateList(perRow, aggregate)), count: perRow.length });
      });
      return { value: result, unit: 'list', rowsProcessed: ctx.rows.length, warnings, metadata: {} };
    }

    const perRow = [];
    ctx.rows.forEach((row, i) => {
      let v;
      try { v = compiled.run(row); }
      catch (e) {
        if (e instanceof EngineError && e.code === ERROR_CODES.DIVISION_BY_ZERO) {
          if (warnings.length < ENGINE_CONFIG.MAX_WARNINGS_PER_ISSUE) warnings.push(`Row ${ctx.rowNumbers[i]}: formula divided by zero — skipped.`);
          return;
        }
        throw e;
      }
      if (v === null) {
        if (warnings.length < ENGINE_CONFIG.MAX_WARNINGS_PER_ISSUE) warnings.push(`Row ${ctx.rowNumbers[i]}: a column referenced in the formula was empty/invalid — skipped.`);
        return;
      }
      perRow.push(v);
    });

    if (aggregate === 'NONE') {
      const truncated = perRow.length > 500;
      if (truncated) warnings.push(`Result truncated to first 500 of ${perRow.length} computed values.`);
      return { value: perRow.slice(0, 500).map(v => Util.round(v)), unit: 'list', rowsProcessed: perRow.length, warnings, metadata: { truncated } };
    }
    if (!perRow.length) throw new EngineError(ERROR_CODES.INSUFFICIENT_DATA, 'Formula produced no valid results across the filtered rows.');
    return { value: Util.round(aggregateList(perRow, aggregate)), unit: 'number', rowsProcessed: perRow.length, warnings, metadata: {} };
  }
};

function aggregateList(values, aggregate) {
  switch (aggregate) {
    case 'SUM': return values.reduce((a, b) => a + b, 0);
    case 'AVERAGE': return AggregationHelpers.mean(values);
    case 'MIN': return Math.min(...values);
    case 'MAX': return Math.max(...values);
    case 'MEDIAN': return AggregationHelpers.median(values);
    case 'COUNT': return values.length;
    case 'FIRST': return values[0];
    case 'LAST': return values[values.length - 1];
    default: return values.reduce((a, b) => a + b, 0);
  }
}

function groupOperation(ctx, aggregation) {
  const groupByParam = requireParam(ctx.params, 'groupBy');
  const groupCols = Array.isArray(groupByParam) ? groupByParam : [groupByParam];
  const groupColIndices = groupCols.map(c => SchemaEngine.resolveColumnIndex(ctx.headers, c));
  let valueColIdx = null, headerName = null;
  if (aggregation !== 'COUNT') {
    valueColIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
    headerName = ctx.headers[valueColIdx];
  }
  const groups = AggregationHelpers.groupRows(ctx.rows, groupColIndices);
  const warnings = [];
  const result = [];
  groups.forEach(({ labelParts, rows }) => {
    const value = aggregation === 'COUNT' ? rows.length : AggregationHelpers.aggregateGroup(rows, valueColIdx, headerName, aggregation);
    result.push({ group: labelParts.length > 1 ? labelParts.join(' | ') : labelParts[0], value: (typeof value === 'number' ? Util.round(value) : value), count: rows.length });
  });
  result.sort((a, b) => (typeof b.value === 'number' && typeof a.value === 'number') ? b.value - a.value : 0);
  return { value: result, unit: 'list', rowsProcessed: ctx.rows.length, warnings, metadata: { groupCount: result.length } };
}

function topBottomN(ctx, direction) {
  const n = ctx.params.n ? parseInt(ctx.params.n, 10) : 10;
  if (!Number.isFinite(n) || n <= 0) throw new EngineError(ERROR_CODES.INVALID_REQUEST, '"n" must be a positive integer.');
  const aggregation = (ctx.params.aggregation || 'SUM').toUpperCase();
  const grouped = groupOperation(ctx, aggregation);
  const sorted = grouped.value.slice().sort((a, b) => direction === 'desc' ? b.value - a.value : a.value - b.value);
  return { value: sorted.slice(0, n), unit: 'list', rowsProcessed: ctx.rows.length, warnings: grouped.warnings, metadata: { totalGroups: grouped.value.length, n } };
}

function firstOrLast(ctx, which) {
  const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, requireParam(ctx.params, 'valueColumn'));
  let rows = ctx.rows;
  let rowNumbers = ctx.rowNumbers;
  if (ctx.params.sortColumn) {
    const sortColIdx = SchemaEngine.resolveColumnIndex(ctx.headers, ctx.params.sortColumn);
    const paired = rows.map((r, i) => ({ r, rn: rowNumbers[i] }));
    paired.sort((x, y) => {
      const dx = DataParser.parseDate(x.r[sortColIdx]), dy = DataParser.parseDate(y.r[sortColIdx]);
      if (dx && dy) return dx - dy;
      const nx = DataParser.parseNumber(x.r[sortColIdx]), ny = DataParser.parseNumber(y.r[sortColIdx]);
      if (nx !== null && ny !== null) return nx - ny;
      return 0;
    });
    rows = paired.map(p => p.r);
    rowNumbers = paired.map(p => p.rn);
  }
  const ordered = which === 'first' ? rows : rows.slice().reverse();
  for (const row of ordered) {
    const raw = row[colIdx];
    if (!Util.isBlank(raw)) {
      return { value: raw instanceof Date ? raw.toISOString() : raw, unit: 'text', rowsProcessed: rows.length, warnings: [], metadata: {} };
    }
  }
  throw new EngineError(ERROR_CODES.INSUFFICIENT_DATA, `No non-empty value found in column "${ctx.headers[colIdx]}".`);
}

/** Resolves an operand for RATIO/RATE/PERCENTAGE/etc. Can be a literal number,
 *  a reference to a prior calculation's id (multi-calc batches), a column
 *  name (summed over the filtered rows), or { column, aggregation }. */
function resolveOperand(operand, ctx) {
  if (typeof operand === 'number') return operand;
  if (typeof operand === 'string') {
    if (ctx.priorResults && Object.prototype.hasOwnProperty.call(ctx.priorResults, operand)) {
      const prior = ctx.priorResults[operand];
      if (typeof prior.value !== 'number') {
        throw new EngineError(ERROR_CODES.INVALID_REQUEST, `Calculation "${operand}" did not produce a numeric value to reference.`);
      }
      return prior.value;
    }
    const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, operand);
    const { values } = AggregationHelpers.extractNumeric(ctx.rows, colIdx, operand, ctx.rowNumbers);
    return values.reduce((a, b) => a + b, 0);
  }
  if (Util.isPlainObject(operand)) {
    if (typeof operand.value === 'number') return operand.value;
    if (operand.column) {
      const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, operand.column);
      const aggregation = (operand.aggregation || 'SUM').toUpperCase();
      return AggregationHelpers.aggregateGroup(ctx.rows, colIdx, operand.column, aggregation);
    }
  }
  throw new EngineError(ERROR_CODES.INVALID_REQUEST, `Could not resolve operand: ${JSON.stringify(operand)}`);
}

/** Resolves { current, previous } for CHANGE / CHANGE_PERCENTAGE / GROWTH_PERCENTAGE.
 *  Each side may be a literal number, or { filters, valueColumn, aggregation }
 *  which is applied against ctx.allRows (the sheet's unfiltered data). */
function resolveComparablePair(ctx) {
  const currentSpec = requireParam(ctx.params, 'current');
  const previousSpec = requireParam(ctx.params, 'previous');
  return { current: resolveSide(currentSpec), previous: resolveSide(previousSpec) };

  function resolveSide(spec) {
    if (typeof spec === 'number') return spec;
    if (Util.isPlainObject(spec)) {
      if (typeof spec.value === 'number') return spec.value;
      const valueColumn = requireParam(spec, 'valueColumn');
      const colIdx = SchemaEngine.resolveColumnIndex(ctx.headers, valueColumn);
      const subset = FilterEngine.applyFilters(ctx.allRows, ctx.headers, spec.filters);
      const aggregation = (spec.aggregation || 'SUM').toUpperCase();
      return AggregationHelpers.aggregateGroup(subset, colIdx, valueColumn, aggregation);
    }
    throw new EngineError(ERROR_CODES.INVALID_REQUEST, `Invalid comparison operand: ${JSON.stringify(spec)}`);
  }
}

function requireParam(params, name) {
  if (!params || params[name] === undefined || params[name] === null || params[name] === '') {
    throw new EngineError(ERROR_CODES.INVALID_REQUEST, `Missing required parameter "${name}".`);
  }
  return params[name];
}

// Short docs for each operation, surfaced via getSupportedOperations() so an
// LLM caller knows what's available and what parameters each one expects.
const OPERATION_DOCS = {
  SUM: 'Sum of a numeric column. Params: valueColumn.',
  AVERAGE: 'Mean of a numeric column. Params: valueColumn.',
  COUNT: 'Row count after filters. Params: none.',
  COUNT_NUMERIC: 'Count of parseable numeric values in a column. Params: valueColumn.',
  COUNT_NON_EMPTY: 'Count of non-blank cells. Params: valueColumn.',
  COUNT_EMPTY: 'Count of blank cells. Params: valueColumn.',
  COUNT_DISTINCT: 'Count of distinct non-blank values. Params: valueColumn.',
  COUNT_IF: 'Count rows where a condition holds. Params: conditionColumn (or valueColumn), condition: {operator, value}.',
  COUNT_DISTINCT_IF: 'Distinct count of a column where a condition holds. Params: distinctColumn, conditionColumn, condition.',
  MIN: 'Minimum value. Params: valueColumn.',
  MAX: 'Maximum value. Params: valueColumn.',
  MEDIAN: 'Median value. Params: valueColumn.',
  MODE: 'Most frequent value. Params: valueColumn.',
  RANGE: 'Max minus min. Params: valueColumn.',
  SUM_SQUARES: 'Sum of squared values. Params: valueColumn.',
  STANDARD_DEVIATION: 'Standard deviation. Params: valueColumn, population (bool, default false).',
  VARIANCE: 'Variance. Params: valueColumn, population (bool, default false).',
  PERCENTAGE: '(value/total)*100. Params: value, total (numbers, column names, or {column,aggregation}).',
  PERCENTAGE_OF_TOTAL: 'What % of the column\'s grand total (ignoring filters) the filtered subset represents. Params: valueColumn.',
  RATIO: 'numerator/denominator. Params: numerator, denominator.',
  RATE: '(numerator/denominator)*100. Params: numerator, denominator.',
  CHANGE: 'current - previous. Params: current, previous.',
  CHANGE_PERCENTAGE: '((current-previous)/previous)*100. Params: current, previous.',
  GROWTH_PERCENTAGE: 'Alias of CHANGE_PERCENTAGE.',
  WEIGHTED_AVERAGE: 'Weighted mean. Params: valueColumn, weightColumn.',
  FIRST: 'First non-empty value (optionally sorted). Params: valueColumn, sortColumn?.',
  LAST: 'Last non-empty value (optionally sorted). Params: valueColumn, sortColumn?.',
  TOP_N: 'Top N groups by aggregated value. Params: groupBy, valueColumn, n?, aggregation?.',
  BOTTOM_N: 'Bottom N groups by aggregated value. Params: groupBy, valueColumn, n?, aggregation?.',
  RANK: 'Ranks groups by aggregated value. Params: groupBy, valueColumn, aggregation?, order?, identify?.',
  UNIQUE_VALUES: 'Distinct values with counts. Params: valueColumn, sortBy? ("count"|"value").',
  GROUP_BY: 'Generic grouping (COUNT if no valueColumn, else SUM). Params: groupBy, valueColumn?.',
  GROUP_SUM: 'Sum per group. Params: groupBy, valueColumn.',
  GROUP_AVERAGE: 'Average per group. Params: groupBy, valueColumn.',
  GROUP_COUNT: 'Row count per group. Params: groupBy.',
  GROUP_MIN: 'Min per group. Params: groupBy, valueColumn.',
  GROUP_MAX: 'Max per group. Params: groupBy, valueColumn.',
  FORMULA: 'Safe multi-column expression (e.g. "Revenue - Cost"), no eval(). Params: formula, aggregate? (SUM/AVERAGE/MIN/MAX/MEDIAN/COUNT/NONE), groupBy?.',
  COMPARE: 'Runs two full sub-requests and diffs them. Params: current (request), previous (request).'
};

// ============================================================================
// 8. VALIDATION ENGINE
// ============================================================================

const ValidationEngine = {
  validateRequest(request) {
    const errors = [];
    if (!Util.isPlainObject(request)) {
      return { valid: false, errors: ['Request must be a JSON object.'] };
    }
    if (!request.sheetName || typeof request.sheetName !== 'string') {
      errors.push('"sheetName" is required and must be a string.');
    }
    const isMultiCalc = Array.isArray(request.calculations);
    if (!isMultiCalc) {
      if (!request.operation || typeof request.operation !== 'string') {
        errors.push('"operation" is required and must be a string.');
      } else if (request.operation.toUpperCase() !== 'COMPARE' && !OPERATIONS[request.operation.toUpperCase()]) {
        errors.push(`Unknown operation "${request.operation}". Call getSupportedOperations() for the full list.`);
      }
      if (request.operation.toUpperCase() === 'COMPARE') {
        if (!Util.isPlainObject(request.current)) errors.push('COMPARE requires a "current" sub-request object.');
        if (!Util.isPlainObject(request.previous)) errors.push('COMPARE requires a "previous" sub-request object.');
        [request.current, request.previous].forEach((sub, i) => {
          if (!Util.isPlainObject(sub)) return;
          const label = i === 0 ? 'current' : 'previous';
          if (!sub.operation || typeof sub.operation !== 'string') errors.push(`COMPARE ${label} requires an "operation".`);
          else if (sub.operation.toUpperCase() === 'COMPARE') errors.push(`COMPARE ${label} cannot itself be COMPARE.`);
          else if (!OPERATIONS[sub.operation.toUpperCase()]) errors.push(`COMPARE ${label} has invalid operation "${sub.operation}".`);
          if (sub.filters) errors.push(...ValidationEngine._validateFilterSpec(sub.filters, `COMPARE.${label}.filters`));
        });
      }
    } else {
      request.calculations.forEach((c, i) => {
        if (!c.id) errors.push(`calculations[${i}] is missing an "id".`);
        if (!c.operation || typeof c.operation !== 'string' || (!OPERATIONS[c.operation.toUpperCase()] && c.operation.toUpperCase() !== 'COMPARE')) errors.push(`calculations[${i}] has an invalid "operation".`);
      });
    }
    if (request.filters) {
      const errs = ValidationEngine._validateFilterSpec(request.filters);
      errors.push(...errs);
    }
    return { valid: errors.length === 0, errors };
  },

  _validateFilterSpec(spec, path) {
    path = path || 'filters';
    const errors = [];
    const list = Array.isArray(spec) ? spec : (spec.filters || []);
    list.forEach((f, i) => {
      if (f.filters) {
        errors.push(...ValidationEngine._validateFilterSpec(f, `${path}[${i}]`));
        return;
      }
      if (!f.column) errors.push(`${path}[${i}] is missing "column".`);
      const rawOp = f.operator || '=';
      const op = typeof rawOp === 'string' && !['=', '==', '!=', '<>', '>', '<', '>=', '<='].includes(rawOp) ? rawOp.toUpperCase() : rawOp;
      if (!FilterEngine.SUPPORTED_OPERATORS.concat(['CONTAINS','NOT_CONTAINS','STARTS_WITH','ENDS_WITH','EQUALS_IGNORE_CASE','IS_EMPTY','IS_NOT_EMPTY','BETWEEN','IN','NOT_IN']).includes(op)) {
        errors.push(`${path}[${i}] has an unsupported operator "${op}".`);
      }
    });
    return errors;
  }
};

// ============================================================================
// 9. RESULT FORMATTER
// ============================================================================

const ResultFormatter = {
  success(operation, opResult, extra) {
    return Object.assign({
      success: true,
      operation,
      value: opResult.value,
      unit: opResult.unit || 'number',
      currency: opResult.unit === 'currency' ? ENGINE_CONFIG.DEFAULT_CURRENCY : undefined,
      rowsMatched: extra && extra.rowsMatched,
      rowsProcessed: opResult.rowsProcessed,
      warnings: opResult.warnings || [],
      metadata: opResult.metadata || {}
    }, extra && extra.extraFields ? extra.extraFields : {});
  },

  error(code, message, details) {
    return { success: false, error: { code: code || ERROR_CODES.INTERNAL_ERROR, message, details: details || {} } };
  }
};

// ============================================================================
// 10. CALCULATION ENGINE — orchestration
// ============================================================================

const CalculationEngine = {
  /** Runs a single already-resolved operation against a prepared context. */
  _runSingleOperation(operationName, params, ctx) {
    const opFn = operationName === 'COMPARE' ? null : OPERATIONS[operationName];
    if (operationName !== 'COMPARE' && !opFn) {
      throw new EngineError(ERROR_CODES.INVALID_OPERATION, `Unknown operation "${operationName}".`);
    }
    if (operationName === 'COMPARE') {
      const currentResult = CalculationEngine.calculate(Object.assign({}, params.current, { sheetName: ctx.sheetName, operation: String(params.current.operation).toUpperCase() }));
      const previousResult = CalculationEngine.calculate(Object.assign({}, params.previous, { sheetName: ctx.sheetName, operation: String(params.previous.operation).toUpperCase() }));
      if (!currentResult.success) throw new EngineError(currentResult.error.code, `In COMPARE "current": ${currentResult.error.message}`);
      if (!previousResult.success) throw new EngineError(previousResult.error.code, `In COMPARE "previous": ${previousResult.error.message}`);
      const current = currentResult.value, previous = previousResult.value;
      const difference = Util.round(current - previous);
      const percentageChange = previous === 0 ? null : Util.round(((current - previous) / Math.abs(previous)) * 100, 2);
      return {
        value: { current, previous, difference, percentageChange },
        unit: 'comparison', rowsProcessed: (currentResult.rowsProcessed || 0) + (previousResult.rowsProcessed || 0),
        warnings: [].concat(currentResult.warnings || [], previousResult.warnings || []), metadata: {}
      };
    }
    return opFn(Object.assign({ params }, ctx));
  },

  /**
   * Main entry point. Accepts a single-operation request, a COMPARE request,
   * or a multi-calculation batch ({ calculations: [...] }).
   */
  calculate(request) {
    try {
      const validation = ValidationEngine.validateRequest(request);
      if (!validation.valid) {
        throw new EngineError(ERROR_CODES.INVALID_REQUEST, validation.errors.join(' '));
      }

      const operation = request.operation ? request.operation.toUpperCase() : null;
      const { headers, rows, rowNumbers } = SchemaEngine.readSheetData(request.sheetName, request.headerRow);
      const totalRows = rows.length;
      // Preserve exact row-number alignment, including duplicate rows.
      const filtered = FilterEngine.applyFiltersWithRowNumbers(rows, headers, request.filters, rowNumbers);
      const filteredRows = filtered.rows;
      const alignedRowNumbers = filtered.rowNumbers;

      const baseCtx = {
        headers, rows: filteredRows, rowNumbers: alignedRowNumbers, allRows: rows, sheetName: request.sheetName
      };

      if (Array.isArray(request.calculations)) {
        const results = {};
        const warnings = [];
        request.calculations.forEach(calc => {
          try {
            const ctx = Object.assign({}, baseCtx, { priorResults: results });
            const calcOperation = String(calc.operation).toUpperCase();
            const normalizedCalc = Object.assign({}, calc, { operation: calcOperation });
            const opResult = CalculationEngine._runSingleOperation(calcOperation, normalizedCalc, ctx);
            results[calc.id] = ResultFormatter.success(calc.operation, opResult, { rowsMatched: filteredRows.length });
          } catch (e) {
            results[calc.id] = e instanceof EngineError
              ? ResultFormatter.error(e.code, e.message, e.details)
              : ResultFormatter.error(ERROR_CODES.INTERNAL_ERROR, 'Unexpected error: ' + e.message);
          }
        });
        return {
          success: true,
          results,
          totalRows, rowsMatched: filteredRows.length,
          warnings
        };
      }

      const ctx = Object.assign({}, baseCtx, { priorResults: {} });
      const normalizedRequest = Object.assign({}, request, { operation });
      const opResult = CalculationEngine._runSingleOperation(operation, normalizedRequest, ctx);
      return ResultFormatter.success(operation, opResult, { rowsMatched: filteredRows.length });

    } catch (e) {
      if (e instanceof EngineError) {
        return ResultFormatter.error(e.code, e.message, e.details);
      }
      // Never leak a raw Apps Script stack trace — wrap unknown errors.
      return ResultFormatter.error(ERROR_CODES.INTERNAL_ERROR, 'An unexpected error occurred: ' + e.message);
    }
  }
};

// ============================================================================
// 11. PUBLIC API
// ============================================================================

/** Main entry point — call this from your LLM webhook / doPost handler. */
function calculate(request) {
  return CalculationEngine.calculate(request);
}

function validateRequest(request) {
  return ValidationEngine.validateRequest(request);
}

function getSheetSchema(sheetName, headerRow) {
  try {
    return SchemaEngine.getSheetSchema(sheetName, headerRow);
  } catch (e) {
    return e instanceof EngineError ? ResultFormatter.error(e.code, e.message) : ResultFormatter.error(ERROR_CODES.INTERNAL_ERROR, e.message);
  }
}

function getAvailableColumns(sheetName) {
  try {
    return SchemaEngine.getAvailableColumns(sheetName);
  } catch (e) {
    return e instanceof EngineError ? ResultFormatter.error(e.code, e.message) : ResultFormatter.error(ERROR_CODES.INTERNAL_ERROR, e.message);
  }
}

function getSupportedOperations() {
  return Object.keys(OPERATION_DOCS).map(name => ({ operation: name, description: OPERATION_DOCS[name] }));
}

// ============================================================================
// 12. TESTS & EXAMPLE REQUESTS
// ============================================================================
// Run test_setupSampleData() once from the Apps Script editor to create a
// "Sales" sheet with synthetic data, then run runAllEngineTests() to see the
// engine exercised against it (check View > Logs / Executions for output).

function test_setupSampleData() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName('Sales');
  if (sheet) ss.deleteSheet(sheet);
  sheet = ss.insertSheet('Sales');

  const headers = ['Date', 'Product', 'City', 'Amount', 'Cost', 'Status', 'Order ID'];
  const products = ['Product A', 'Product B', 'Product C'];
  const cities = ['Delhi', 'Mumbai', 'Bengaluru'];
  const statuses = ['Paid', 'Pending', 'Refunded'];

  const rows = [headers];
  const today = new Date();
  for (let i = 0; i < 200; i++) {
    const daysAgo = Math.floor(Math.random() * 120);
    const date = new Date(today);
    date.setDate(date.getDate() - daysAgo);
    const amount = Math.round((500 + Math.random() * 9500) * 100) / 100;
    const cost = Math.round(amount * (0.4 + Math.random() * 0.3) * 100) / 100;
    rows.push([
      date,
      products[Math.floor(Math.random() * products.length)],
      cities[Math.floor(Math.random() * cities.length)],
      amount,
      cost,
      statuses[Math.floor(Math.random() * statuses.length)],
      'ORD-' + (1000 + i)
    ]);
  }
  sheet.getRange(1, 1, rows.length, headers.length).setValues(rows);
  Logger.log('Sample "Sales" sheet created with 200 rows.');
}

function runAllEngineTests() {
  const log = (label, result) => Logger.log(label + ': ' + JSON.stringify(result));

  log('Schema', getSheetSchema('Sales'));
  log('Columns', getAvailableColumns('Sales'));

  log('SUM Paid (this month)', calculate({
    sheetName: 'Sales', operation: 'SUM', valueColumn: 'Amount',
    filters: [{ column: 'Status', operator: '=', value: 'Paid' }, { column: 'Date', operator: 'THIS_MONTH' }]
  }));

  log('GROUP_SUM by Product', calculate({
    sheetName: 'Sales', operation: 'GROUP_SUM', groupBy: 'Product', valueColumn: 'Amount'
  }));

  log('TOP_N Cities', calculate({
    sheetName: 'Sales', operation: 'TOP_N', groupBy: 'City', valueColumn: 'Amount', n: 2
  }));

  log('FORMULA Profit SUM', calculate({
    sheetName: 'Sales', operation: 'FORMULA', formula: 'Amount - Cost', aggregate: 'SUM'
  }));

  log('CHANGE_PERCENTAGE (this month vs last month)', calculate({
    sheetName: 'Sales', operation: 'CHANGE_PERCENTAGE',
    current: { valueColumn: 'Amount', aggregation: 'SUM', filters: [{ column: 'Date', operator: 'THIS_MONTH' }] },
    previous: { valueColumn: 'Amount', aggregation: 'SUM', filters: [{ column: 'Date', operator: 'LAST_MONTH' }] }
  }));

  log('COMPARE today vs last 7 days average', calculate({
    sheetName: 'Sales', operation: 'COMPARE',
    current: { operation: 'SUM', valueColumn: 'Amount', filters: [{ column: 'Date', operator: 'TODAY' }] },
    previous: { operation: 'AVERAGE', valueColumn: 'Amount', filters: [{ column: 'Date', operator: 'LAST_7_DAYS' }] }
  }));

  log('Multi-calc business report', calculate({
    sheetName: 'Sales',
    calculations: [
      { id: 'totalSales', operation: 'SUM', valueColumn: 'Amount' },
      { id: 'orders', operation: 'COUNT' },
      { id: 'averageOrderValue', operation: 'RATIO', numerator: 'totalSales', denominator: 'orders' }
    ]
  }));

  log('Invalid column (error path)', calculate({
    sheetName: 'Sales', operation: 'SUM', valueColumn: 'NotAColumn'
  }));

  log('Missing sheet (error path)', calculate({
    sheetName: 'DoesNotExist', operation: 'SUM', valueColumn: 'Amount'
  }));

  log('Supported operations', getSupportedOperations());
}

