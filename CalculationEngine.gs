const Util = {
  /** "A" -> 0, "B" -> 1, "AA" -> 26 (0-based). */
  columnLetterToIndex(letter) {
    let result = 0;
    const s = String(letter).toUpperCase();
    for (let i = 0; i < s.length; i++) {
      const code = s.charCodeAt(i) - 64; // 'A' = 1
      if (code < 1 || code > 26) return -1;
      result = result * 26 + code;
    }
